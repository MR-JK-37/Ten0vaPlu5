#!/bin/sh
# Blocks the push if any outgoing commit has an author/committer other than the repo
# owner, or contains an AI-attribution signature. Belt-and-suspenders alongside the
# commit-msg hook and the CI identity-check workflow.
# The owner has committed under both their personal email and the GitHub no-reply
# address (both verified as belonging to MR-JK-37 via the contributors API); allow either.
zero=0000000000000000000000000000000000000000
while read lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  other=$(git log --format='%ae%n%ce' "$range" | sort -u | grep -v -x -e "$(git config user.email)" -e '231611281+MR-JK-37@users.noreply.github.com' -e 'jaikiranjaikiran37@gmail.com' -e 'tdhaarini032@gmail.com' -e 'noreply@github.com' || true)
  sig=$(git log --format='%B' "$range" | grep -iE 'co-authored-by:|claude-session|generated with|anthropic|claude\.ai' || true)
  if [ -n "$other" ] || [ -n "$sig" ]; then
    echo "pre-push BLOCKED: foreign identity or AI signature found in $range." >&2
    [ -n "$other" ] && echo "Foreign identities: $other" >&2
    [ -n "$sig" ] && echo "Signature lines: $sig" >&2
    exit 1
  fi
done
